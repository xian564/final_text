<?xml version="1.0"?>
<package format="2">
  <name>final_text</name>
  <version>0.1.0</version>
  <description>Armor detection, PnP ranging, target selection and tracking (ROS Noetic)</description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>ft_msgs</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>rqt_image_view</exec_depend>
  <exec_depend>rqt_reconfigure</exec_depend>

  <export></export>
</package>
