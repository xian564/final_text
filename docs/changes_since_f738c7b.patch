diff --git a/scripts/eval_prediction.py b/scripts/eval_prediction.py
new file mode 100644
index 0000000..b5347f9
--- /dev/null
+++ b/scripts/eval_prediction.py
@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+# 评估 position_predict 与“下一帧实际检测”的误差（不用真值）
+import sys, math, rosbag
+from ft_msgs.msg import Detections, Track
+
+def pos(p): return (p.x, p.y, p.z)
+def dist(a,b): return math.sqrt(sum((a[i]-b[i])**2 for i in range(3)))
+
+def main(bag_path, track_topic):
+    bag = rosbag.Bag(bag_path)
+    dets=[]; tracks=[]
+    for topic,msg,_ in bag.read_messages(topics=['/ft/detection', track_topic]):
+        if topic=='/ft/detection':
+            dets.append((msg.header.stamp.to_sec(), [pos(d.pose.position) for d in msg.detections]))
+        else:
+            tracks.append((msg.header.stamp.to_sec(), msg.tracking,
+                           pos(msg.position), pos(msg.position_predict)))
+    bag.close()
+    errs=[]
+    for t,trk,cur,pred in tracks:
+        if not trk: continue
+        nxt=[d for d in dets if t < d[0] <= t+0.25]
+        if not nxt: continue
+        cand=[p for p in nxt[0][1]]
+        if not cand: continue
+        # 用当前位置匹配下一帧的同一块板
+        actual=min(cand, key=lambda p: dist(p,cur))
+        errs.append(dist(pred,actual))
+    if errs:
+        errs.sort()
+        print(track_topic, "n=",len(errs),
+              "mean=%.3f m"% (sum(errs)/len(errs)),
+              "median=%.3f m"% errs[len(errs)//2])
+    else:
+        print(track_topic,"no samples")
+
+if __name__=='__main__':
+    main(sys.argv[1], sys.argv[2])
diff --git a/scripts/record_debug_video.py b/scripts/record_debug_video.py
new file mode 100644
index 0000000..6e48b93
--- /dev/null
+++ b/scripts/record_debug_video.py
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+# 录 /ft/debug/image 为帧序列（10Hz），用于拼演示视频
+# 用法: python3 record_debug_video.py /tmp/vid/s1 40
+import os, sys, time, rospy, cv_bridge, cv2
+from sensor_msgs.msg import Image
+
+out = sys.argv[1]
+secs = float(sys.argv[2]) if len(sys.argv) > 2 else 30.0
+os.makedirs(out, exist_ok=True)
+bridge = cv_bridge.CvBridge()
+last = [0.0]; idx = [0]
+
+def cb(msg):
+    t = time.time()
+    if t - last[0] < 0.1:   # 10 Hz
+        return
+    last[0] = t
+    try:
+        img = bridge.imgmsg_to_cv2(msg, 'bgr8')
+    except Exception:
+        return
+    cv2.imwrite(os.path.join(out, 'f_%05d.jpg' % idx[0]), img)
+    idx[0] += 1
+
+rospy.init_node('rec_video')
+rospy.Subscriber('/ft/debug/image', Image, cb)
+end = time.time() + secs
+while time.time() < end and not rospy.is_shutdown():
+    time.sleep(0.05)
+print('frames', idx[0])
