<launch>
    <param name="use_sim_time" value="true" />
    <arg name="mode" default="tradition" />   <!-- tradition | nn -->
    <arg name="model_path" default="/root/catkin_ws/bag/armor_allfp32.onnx" />
    <arg name="open_rqt" default="true" />

    <node pkg="final_text" type="detect_node_v3_1" name="vision_node_v3" output="screen" respawn="true">
        <rosparam command="load" file="$(find final_text)/config/params.yaml" />
        <param name="nn_enable" value="$(eval arg('mode') == 'nn')" />
        <param name="nn_model_path" value="$(arg model_path)" />
    </node>

    <node pkg="final_text" type="ft_tracker_node" name="ft_tracker" output="screen" respawn="true">
        <rosparam command="load" file="$(find final_text)/config/tracker.yaml" />
    </node>

    <node pkg="tf2_ros" type="static_transform_publisher" name="cam_visual_tf"
          args="0 0 0 0 0 0 camera2_optical_frame hk_camera_ca" />

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find final_text)/rviz/armor_v3.rviz">
        <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
    </node>

    <group if="$(arg open_rqt)">
        <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view"
              args="/ft/debug/image" output="screen">
            <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
        </node>
        <node pkg="rqt_reconfigure" type="rqt_reconfigure" name="rqt_reconfigure" output="screen">
            <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
        </node>
    </group>
</launch>
