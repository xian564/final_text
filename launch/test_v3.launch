<launch>
    <param name="use_sim_time" value="true" />

    <node pkg="final_text" type="detect_node_v3" name="vision_node_v3" output="screen" />

    <node pkg="rqt_image_view" type="rqt_image_view" name="rqt_image_view_v3" args="/ft/debug/image">
        <env name="LIBGL_ALWAYS_SOFTWARE" value="1" />
    </node>
</launch>
